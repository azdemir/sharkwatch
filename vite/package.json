{
  "name": "sharkwatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "doctor": "tsx scripts/doctor.ts",
    "pipeline": "tsx scripts/pipeline.ts",
    "telegram:test": "tsx scripts/telegram-test.ts",
    "spike:sam": "tsx scripts/spike-sam.ts",
    "spike:spark": "tsx scripts/spike-spark.ts",
    "prepare-clip": "tsx scripts/prepare-clip.ts",
    "record:golden": "tsx scripts/record-golden.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@meta-sam/parser": "^0.1.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fastify": "^5.12.7",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "openai": "^4.104.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "sharp": "^0.35.5",
    "tsx": "^4.16.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "type": "module"
}
