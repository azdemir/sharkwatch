# Copy to .env on your Mac and fill in your own values. Never commit .env.
# This file must contain placeholders only — no real tokens or keys.
# Telegram bot token from @BotFather (/newbot). Used by /api/telegram and by
# POST /api/reports to broadcast new reports to Telegram subscribers.
TELEGRAM_BOT_TOKEN=
# Meta API key for Live SAM 3.1 + Muse Spark detection. MODEL_API_KEY is
# preferred; META_KEY is accepted as a fallback.
MODEL_API_KEY=
# Real Telegram broadcasts are OFF unless this is exactly 1. Without it,
# Replay never messages real subscribers, Live stays in-app only, and the
# /api/telegram test endpoint returns a sandbox error instead of sending.
# Set to 1 only for a deliberate Live run by the operator.
TELEGRAM_REAL_ALERTS=
